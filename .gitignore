# Compiled programs live in bin/, never next to the sources.
/bin/
# State written by versions before 1loop moved it to ~/.config/1loop.
/.1loop/
# A stray build from before the Makefile wrote to bin/.
/1loop

# Local secrets: never committed. release-key.pem signs the updates: keep a
# copy somewhere safe, installed apps only trust updates signed with it.
/TOKEN
*.pem
*.key
*.p12
*.jks
*.keystore
/android/signing/
# Release archives (make release).
/dist/
# nix build (make nix).
/result

# The maintainer's own notes, design drafts and AI agent settings: kept
# locally only.
/AGENTS.md
/CLAUDE.md
/MEMORY.md
/TODO.md
/AFAIRE.md
/LIS-MOI-SI-TU-ES-CLAUDE.md
/.claude/
/DA/*.html
