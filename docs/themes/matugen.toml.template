# A matugen template: matugen fills in the {{…}} from your wallpaper.
# In ~/.config/matugen/config.toml:
#   [templates.oneloop]
#   input_path = "~/.config/matugen/templates/1loop.toml"
#   output_path = "~/.config/1loop/themes/matugen.toml"
# 1loop picks the new file up as soon as matugen writes it.
name = "Matugen"
base = "dark"
accents = ["{{colors.primary.default.hex}}"]
roundness = 1.2

[colors]
background = "{{colors.surface.default.hex}}"
sidebar = "{{colors.surface_container_lowest.default.hex}}"
surface = "{{colors.surface_container.default.hex}}"
popover = "{{colors.surface_container_high.default.hex}}"
raised = "{{colors.surface_container_highest.default.hex}}"
border = "{{colors.outline_variant.default.hex}}"
text = "{{colors.on_surface.default.hex}}"
muted = "{{colors.on_surface_variant.default.hex}}"
danger = "{{colors.error.default.hex}}"
