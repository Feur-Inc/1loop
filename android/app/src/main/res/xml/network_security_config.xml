<?xml version="1.0" encoding="utf-8"?>
<!-- Only the agent's browser (WebView) may open plain HTTP pages, such as a
     project served on the local network. The app's own API calls refuse plain
     HTTP except to this phone itself (Api in Net.kt): tokens only travel over
     HTTPS with a pinned certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
